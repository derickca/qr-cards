<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Deliberately no INTERNET permission: the app is fully offline by design.
         See SPEC-v1.md quality bars. -->

    <!-- Requested at runtime only, when the feature is used: READ_CONTACTS
         when contact import's picker grant doesn't cover the data rows;
         location permissions when "Current location" is tapped. Android 12+
         requires COARSE alongside FINE (lint CoarseFineLocation); both are
         requested together and either grant is enough to proceed. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.QRCards">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Present mode. Exported so launcher app-shortcuts can deep-link here. -->
        <activity
            android:name=".CardDetailActivity"
            android:exported="true"
            android:launchMode="singleTop" />
        <activity
            android:name=".CardEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Serves PNGs shared via ACTION_SEND. Grant is per-share intent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>
    </application>

</manifest>
