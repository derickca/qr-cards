<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Deliberately no INTERNET permission: the app is fully offline by design.
         See SPEC-v1.md quality bars. -->

    <!-- Requested at runtime only, when the feature is used: READ_CONTACTS
         when contact import's picker grant doesn't cover the data rows;
         location permissions when "Current location" is tapped. Android 12+
         requires COARSE alongside FINE (lint CoarseFineLocation); both are
         requested together and either grant is enough to proceed. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.QRCards">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share sheet target: shared text becomes a new card draft.
                 The editor always opens for confirmation — nothing is ever
                 created silently. Images are declined with a friendly note.
                 text/x-vcard (+text/vcard): contact shares from the system
                 Contacts app arrive as a .vcf stream; the stream is read
                 and parsed into a Contact draft. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/x-vcard" />
                <data android:mimeType="text/vcard" />
            </intent-filter>
            <!-- Tapping a .qrcards backup file offers QR Cards: the file is
                 imported through the same flow as in-app import (encrypted
                 backups ask for the password first). Extension-based match:
                 file managers report these files under various MIME types,
                 so the match is on the path, not the type. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.qrcards" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- Present mode. Exported so launcher app-shortcuts can deep-link here. -->
        <activity
            android:name=".CardDetailActivity"
            android:exported="true"
            android:launchMode="singleTop" />
        <activity
            android:name=".CardEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- "My Card" home-screen widget: 1–4 buttons opening cards in
             present mode. No permissions needed. -->
        <receiver
            android:name=".widget.MyCardWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/my_card_widget_info" />
        </receiver>

        <activity
            android:name=".widget.MyCardWidgetConfigureActivity"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Serves PNGs shared via ACTION_SEND. Grant is per-share intent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>
    </application>

</manifest>
