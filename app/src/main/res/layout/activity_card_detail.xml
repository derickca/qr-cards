<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <!-- Tappable card: front shows the QR, back shows the card's details.
         Tapping anywhere on the card flips between the two faces (instant
         swap when the system's reduced-motion setting is on). Every
         non-interactive view on the back face carries the flip tap — text,
         rows, and empty space all toggle back to the QR. -->
    <FrameLayout
        android:id="@+id/qrFlipContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/flip_to_data_desc">

        <ImageView
            android:id="@+id/qrImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@string/qr_code"
            android:padding="24dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:id="@+id/qrDataView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/show_details_title"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <ScrollView
                android:id="@+id/dataScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:id="@+id/dataRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
            <!-- No copy button here: the action rows below hold the single
                 Copy, so there is exactly one Copy affordance per face. -->
        </LinearLayout>
    </FrameLayout>

    <!-- Content actions as oval icon buttons, in two grouped rows with
         generous whitespace so the targets are easy to discriminate.
         Top row: Copy + the saves (Export SVG, Save .vcf).
         Middle row: the shares (Share PNG, Share vCard).
         Every button is a fixed 56dp square with a stadium background, so
         one-icon and two-icon buttons are the same size. The vCard pair
         shows only for contact cards. Each button carries its label as
         content description + tooltip; inner icons are decorative. -->
    <LinearLayout
        android:id="@+id/actionRowTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="16dp">

        <FrameLayout
            android:id="@+id/copyPayloadButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_oval_button"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/copy"
            android:tooltipText="@string/copy">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_copy"
                app:tint="?attr/colorOnSurfaceVariant" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/exportSvgButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_oval_button"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/export_svg"
            android:tooltipText="@string/export_svg">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_download"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_image"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/saveVcardButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_oval_button"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/save_vcf"
            android:tooltipText="@string/save_vcf"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_download"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_type_contact"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actionRowMiddle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="12dp">

        <FrameLayout
            android:id="@+id/sharePngButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_oval_button"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/share_png"
            android:tooltipText="@string/share_png">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_share"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_image"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/shareVcardButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_oval_button"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/share_vcard"
            android:tooltipText="@string/share_vcard"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_share"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_type_contact"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Management actions: Edit and Delete live in their own row at the
         bottom, separate from the content actions above. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="24dp"
        android:paddingTop="12dp">

        <Button
            android:id="@+id/editButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/edit"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <Button
            android:id="@+id/deleteButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delete"
            android:textColor="?attr/colorError"
            style="@style/Widget.Material3.Button.TextButton" />
    </LinearLayout>
</LinearLayout>
