<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <!-- Tappable card: front shows the QR, back shows the card's details.
         Tapping flips between them (instant swap when the system's
         reduced-motion setting is on). Every non-interactive layer of the
         back face carries the flip tap — a tap anywhere on the card
         toggles, both directions. -->
    <FrameLayout
        android:id="@+id/qrFlipContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/flip_to_data_desc">

        <ImageView
            android:id="@+id/qrImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@string/qr_code"
            android:padding="24dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:id="@+id/qrDataView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/show_details_title"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <ScrollView
                android:id="@+id/dataScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:id="@+id/dataRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
            <!-- No copy button here: the action row below holds the single
                 Copy, so there is exactly one Copy affordance per face. -->
        </LinearLayout>
    </FrameLayout>

    <!-- Content actions: everything you can do WITH the card's content,
         grouped together in one consistent spot under the card. (The
         toolbar already names the card, so the name isn't repeated here.) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="16dp">

        <Button
            android:id="@+id/sharePngButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/share_png" />

        <Button
            android:id="@+id/exportSvgButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/export_svg"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <Button
            android:id="@+id/copyPayloadButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/copy"
            style="@style/Widget.Material3.Button.OutlinedButton" />
    </LinearLayout>

    <!-- Contact cards only: vCard download & sharing, beside the content row. -->
    <LinearLayout
        android:id="@+id/vcardRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/shareVcardButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/share_vcard"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <Button
            android:id="@+id/saveVcardButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save_vcf"
            style="@style/Widget.Material3.Button.OutlinedButton" />
    </LinearLayout>

    <!-- Management actions: Edit and Delete live in their own row at the
         bottom, separate from the content actions above. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="24dp"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/editButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/edit"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <Button
            android:id="@+id/deleteButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delete"
            android:textColor="?attr/colorError"
            style="@style/Widget.Material3.Button.TextButton" />
    </LinearLayout>
</LinearLayout>
